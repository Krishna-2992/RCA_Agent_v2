# Copy to .env and fill in. Never commit .env.

# Azure OpenAI - chat goes through the model router (same values as POC v1)
LLM_MODEL_ENDPOINT=
LLM_MODEL_KEY=
LLM_MODEL_DEPLOYMENT_NAME=model-router

# Azure OpenAI - embeddings (1536 dimensions)
EMBEDDING_MODEL_ENDPOINT=
EMBEDDING_MODEL_KEY=
EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-small

# Supabase Postgres. Dashboard -> Connect -> "Session pooler" connection string
# (works over IPv4). Format:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=RCA Agent v2
